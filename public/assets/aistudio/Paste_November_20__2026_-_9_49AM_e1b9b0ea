  pageMargin: { top: number; bottom: number; right: number; left: number };
  barcodeWidthMm: number;
  barcodeHeightMm: number;
  barcodeType: BarcodeType;
  printerDpi: 203 | 300;
  logoWidthMm: number;
  logoHeightMm: number;
  /** نص اسم المحل أو الفرع (فارغ = اسم المنشأة) */
